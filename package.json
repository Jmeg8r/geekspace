{
  "name": "geekspace",
  "productName": "Geekspace",
  "version": "0.1.0",
  "description": "Your workspace, As The Geek Learns it — Notion-style pages, databases, and a calendar that schedules itself.",
  "author": "James F. Cruce",
  "license": "MIT",
  "private": true,
  "main": "electron/main.mjs",
  "scripts": {
    "backend": "convex dev",
    "frontend": "vite",
    "electron": "wait-on -t 120000 tcp:127.0.0.1:5173 tcp:127.0.0.1:3210 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k -n convex,vite,app -c blue,magenta,yellow \"npm:backend\" \"npm:frontend\" \"npm:electron\"",
    "dev:web": "concurrently -k -n convex,vite -c blue,magenta \"npm:backend\" \"npm:frontend\"",
    "seed": "convex run seed:seedWorkspace",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:eslint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && npm run prebake && npm run build:gs-capture && electron-builder --mac",
    "package:win": "npm run build && npm run prebake && electron-builder --win",
    "prebake": "node scripts/prebake-seed.mjs",
    "build:gs-capture": "node scripts/build-gs-capture.mjs",
    "probe:call-hold": "node scripts/probe-call-hold.mjs",
    "fetch-backend": "node scripts/fetch-backend.mjs",
    "migrate:local-data": "node scripts/migrate-local-data.mjs",
    "deploy:local": "node scripts/deploy-local.mjs",
    "probe:schema-failure": "node scripts/probe-schema-failure.mjs",
    "probe:segment-decode": "node scripts/probe-segment-decode.mjs",
    "verify": "oxlint && tsc -b --noEmit && vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.172",
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@floating-ui/react": "^0.27.0",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "convex": "^1.41.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.17.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@oxlint/plugins": "1.78.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "convex-test": "0.0.50",
    "cross-env": "^10.1.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "oxlint": "1.78.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.astgl.geekspace",
    "productName": "Geekspace",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/convex-seed", "to": "convex-seed" },
      { "from": "build/convex-functions", "to": "convex-functions" },
      { "from": "build/geekspace-mcp.mjs", "to": "geekspace-mcp.mjs" }
    ],
    "afterPack": "scripts/afterPack.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Geekspace reads your macOS Calendar and Mail to show events and messages, and to auto-schedule work around your appointments.",
        "NSMicrophoneUsageDescription": "Geekspace records your microphone for meetings and, when you turn it on, for the Day Recorder, so it can transcribe them. The audio stays on this Mac.",
      "NSAudioCaptureUsageDescription": "Geekspace's Day Recorder records your Mac's system audio, leaving out the apps on your denylist, so it can transcribe your day. The audio stays on this Mac."
      },
      "extraResources": [
        { "from": "build/convex-local-backend", "to": "convex-local-backend" },
        { "from": "native/gs-capture/.build/release/gs-capture", "to": "gs-capture" }
      ]
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon-1024.png",
      "extraResources": [
        { "from": "build/convex-local-backend.exe", "to": "convex-local-backend.exe" }
      ]
    }
  }
}
